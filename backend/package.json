{
  "name": "kanban-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST do sistema Kanban (CRUD de tarefas, Swagger, validação Zod)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:server": "json-server --watch ../database/db.json --port 5555",
    "dev:all": "concurrently -n db,api -c blue,green \"npm run db:server\" \"npm run dev\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "json-server": "^0.17.4",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
